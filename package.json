{
  "name": "zerotrust-employee-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized Zero-Trust Employee Data Management System - Phase 1",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx scripts/demo.ts",
    "e2e": "tsx scripts/e2e.ts",
    "fabric:probe": "tsx scripts/fabric-probe.ts",
    "chain:tamper": "node scripts/chain-demo.mjs",
    "chain:restore": "node scripts/chain-demo.mjs --restore",
    "chain:verify": "tsx scripts/chain-verify.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@hyperledger/fabric-gateway": "^1.12.1",
    "express": "^4.21.2",
    "minio": "^8.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.22.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^3.0.9"
  }
}
