# ============================================================================
# ZeroTrust HRMS - environment configuration
#
# Copy to `.env` and fill in real values for your environment.
# NEVER commit `.env` to version control or hardcode production secrets.
#
# Development fallbacks (generated at startup when missing) are acceptable
# ONLY for local development and are clearly logged as such.
# ============================================================================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT signing secret (HS256). Use `openssl rand -base64 48` in production.
# If omitted in development only, a random secret is generated per boot.
JWT_SECRET=

# Master key for HKDF key derivation of AES-256-GCM data-encryption keys.
# Use `openssl rand -base64 32` in production (min 32 random bytes).
# If omitted in development only, a random master key is generated per boot.
MASTER_KEY=

# Data locations (relative to project root)
DATA_DIR=./data
DB_FILE=./data/hrms.db

# Storage backend: "filesystem" (local dev, no external service) or "minio"
STORAGE_BACKEND=filesystem
# Local-dev object storage root when STORAGE_BACKEND=filesystem
FS_STORAGE_ROOT=./data/objects

# MinIO (used when STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=hrms_dev_access
MINIO_SECRET_KEY=hrms_dev_secret
MINIO_BUCKET=hrms-documents
# Enable to force objects into a private bucket; default private policy is applied
MINIO_PRIVATE_BUCKET=true

# Blockchain: when "sqlite" the audit chain is persisted in the DB (recommended).
# "memory" is for tests only and is NOT production-ready.
BLOCKCHAIN_BACKEND=sqlite

# ----------------------------------------------------------------------------
# Phase 2 - Hyperledger Fabric permissioned audit ledger (OPTIONAL)
#
# Set LEDGER_BACKEND=fabric to submit submittable audit events to the real
# Fabric network as the AUTHORITATIVE multi-organization record. The local
# "BLOCKCHAIN_BACKEND" chain remains a built-in mirror for offline runs and is
# never claimed to be decentralized. Default "off" keeps phase-1 behavior.
#
# The default paths below resolve to the dev network generated by
# fabric/scripts/setup.sh (cryptogen, DEV-ONLY identities).
# ----------------------------------------------------------------------------
LEDGER_BACKEND=off
# Administrator identity used by the backend to sign proposals (MSP of HR org).
FABRIC_MSP_ID=HROrgMSP
FABRIC_MSP_CONFIG_DIR=./fabric/organizations/peerOrganizations/hr.hrms.com/users/Admin@hr.hrms.com/msp
FABRIC_TLS_CA=./fabric/organizations/peerOrganizations/hr.hrms.com/tlsca/tlsca.hr.hrms.com-cert.pem
# Windows host reaches the WSL2 dev network through the published peer port.
FABRIC_PEER_ENDPOINT=localhost:7051
# The network peer's TLS certificate names the peer via this SAN; the gateway
# validates against it even though we connect via localhost.
FABRIC_TLS_HOST_OVERRIDE=peer0.hr.hrms.com
FABRIC_CHANNEL=hrmsaudit
FABRIC_CHAINCODE=hrmsauditcc
# Organizations that must endorse a submission (2-of-4 chaincode policy).
FABRIC_ENDORSE_ORGS=HROrgMSP,FinanceOrgMSP